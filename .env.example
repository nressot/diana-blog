# Sanity Configuration
# Copie ce fichier en .env et remplis les valeurs

# Project ID Sanity (trouve sur sanity.io/manage)
VITE_SANITY_PROJECT_ID=your_project_id_here

# Dataset (generalement "production")
VITE_SANITY_DATASET=production

# Stripe Configuration
# Cle publique Stripe (commence par pk_)
VITE_STRIPE_PUBLIC_KEY=pk_test_your_public_key_here

# Cle secrete Stripe (pour le serverless, commence par sk_)
# NE PAS EXPOSER COTE CLIENT - uniquement dans les variables d'environnement serveur
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# URL du site (pour les redirections Stripe)
SITE_URL=http://localhost:5173

# Webhook secret Stripe (pour la verification des webhooks)
# En dev: obtenu via `stripe listen --forward-to localhost:4000/api/stripe-webhook`
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Resend API Key (pour l'envoi d'emails)
# Creer un compte sur https://resend.com et obtenir une cle API
RESEND_API_KEY=re_your_api_key_here

# Email expediteur (optionnel, utilise Resend par defaut)
# En production, configurer un domaine verifie sur Resend
FROM_EMAIL=Diana <noreply@resend.dev>
